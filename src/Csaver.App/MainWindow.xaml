<Window x:Class="Csaver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Csaver.App"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Csaver Portable Migration" Height="760" Width="1220" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:LocalTimeConverter x:Key="LocalTime" />
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
      <DockPanel>
        <TextBlock x:Name="TitleText" Text="Csaver Portable Migration" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="Language / 语言" VerticalAlignment="Center" Margin="8,0" />
          <ComboBox x:Name="LanguageBox" Width="130" SelectionChanged="LanguageBox_OnSelectionChanged"
                    automation:AutomationProperties.Name="Language">
            <ComboBoxItem Tag="en-US" IsSelected="True">English</ComboBoxItem>
            <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="MainTabs" Margin="0,10,0,0">
      <TabItem x:Name="CommandsTab" Header="Commands">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="CommandBox" DisplayMemberPath="Name" SelectionChanged="CommandBox_OnSelectionChanged"
                      automation:AutomationProperties.Name="Migration command" />
            <TextBlock x:Name="CommandDescription" Grid.Column="1" Margin="12,5" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <WrapPanel Grid.Row="1" Margin="0,5">
            <Button x:Name="RefreshTasksButton" Content="Refresh" Click="RefreshTasksButton_OnClick" automation:AutomationProperties.Name="Refresh tasks" />
            <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAllButton_OnClick" />
            <Button x:Name="SelectNoneButton" Content="Select none" Click="SelectNoneButton_OnClick" />
            <CheckBox x:Name="BroadRootCheck" Content="I understand broad roots may contain unrelated data." Margin="14,8" VerticalAlignment="Center" />
            <ComboBox x:Name="RepairPolicyBox" Width="130" SelectedIndex="0" automation:AutomationProperties.Name="Repair conflict policy">
              <ComboBoxItem>KeepBoth</ComboBoxItem><ComboBoxItem>Newer</ComboBoxItem><ComboBoxItem>SourceWins</ComboBoxItem><ComboBoxItem>DestWins</ComboBoxItem>
            </ComboBox>
            <CheckBox x:Name="AbortConflictCheck" Content="Abort on conflict" Margin="8" VerticalAlignment="Center" />
            <Button x:Name="RunButton" Content="Run selected command" Click="RunButton_OnClick" FontWeight="SemiBold" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_OnClick" IsEnabled="False" />
          </WrapPanel>
          <DataGrid x:Name="TasksGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                    SelectionMode="Extended" EnableRowVirtualization="True" automation:AutomationProperties.Name="Migration tasks">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="42" />
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" IsReadOnly="True" Width="110" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" IsReadOnly="True" Width="110" />
              <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="90" />
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Guard" Binding="{Binding Guard}" IsReadOnly="True" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBox x:Name="OutputBox" Grid.Row="3" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   AcceptsReturn="True" automation:AutomationProperties.Name="Operation progress and results" />
        </Grid>
      </TabItem>

      <TabItem x:Name="ConfigurationTab" Header="Configuration">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="ConfigurationHelp" Text="Edit migration-tasks.json. Changes are validated and backed up before saving." TextWrapping="Wrap" />
          <TabControl Grid.Row="1" Margin="0,8">
            <TabItem Header="Table / Form">
              <Grid Margin="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                  <TextBlock Text="Destination root" Margin="4" VerticalAlignment="Center"/>
                  <TextBox x:Name="DestinationRootEditor" MinWidth="360" automation:AutomationProperties.Name="Default destination root"/>
                </DockPanel>
                <WrapPanel Grid.Row="1">
                  <Button Content="Add task" Click="AddConfigTaskButton_OnClick"/>
                  <Button Content="Remove selected task" Click="RemoveConfigTaskButton_OnClick"/>
                  <Button x:Name="SaveTableConfigButton" Content="Validate and save table" Click="SaveTableConfigButton_OnClick"/>
                </WrapPanel>
                <DataGrid x:Name="ConfigTasksGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          automation:AutomationProperties.Name="Editable migration task configuration">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="135"/>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="100"/>
                    <DataGridTextColumn Header="Root" Binding="{Binding Root}" Width="90"/>
                    <DataGridTextColumn Header="Relative path" Binding="{Binding Rel}" Width="150"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding Dest}" Width="*"/>
                    <DataGridTextColumn Header="Process guard" Binding="{Binding Guard}" Width="130"/>
                    <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem Header="Advanced JSON">
              <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="ConfigurationEditor" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         automation:AutomationProperties.Name="Raw migration configuration JSON" />
                <Button x:Name="SaveConfigButton" Grid.Row="1" HorizontalAlignment="Left" Content="Validate and Save" Click="SaveConfigButton_OnClick"/>
              </Grid>
            </TabItem>
          </TabControl>
          <TextBlock x:Name="ConfigStatus" Grid.Row="2" Margin="12,4" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
      </TabItem>

      <TabItem x:Name="HistoryTab" Header="History">
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><Button x:Name="RefreshHistoryButton" Content="Refresh" Click="RefreshHistoryButton_OnClick"/><Button x:Name="ExportHistoryButton" Content="Export CSV" Click="ExportHistoryButton_OnClick"/><TextBox x:Name="HistoryFilter" Width="260" ToolTip="Filter history" TextChanged="HistoryFilter_OnTextChanged" automation:AutomationProperties.Name="History filter"/></WrapPanel>
          <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" automation:AutomationProperties.Name="Migration history">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time (local)" Binding="{Binding StartedUtc, Converter={StaticResource LocalTime}}" Width="165"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="105"/>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="135"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
              <DataGridTextColumn Header="Bytes" Binding="{Binding SizeBytes}" Width="100"/><DataGridCheckBoxColumn Header="Rollback" Binding="{Binding RollbackEligible}" Width="75"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem x:Name="QuarantineTab" Header="Quarantine">
        <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><Button x:Name="RefreshQuarantineButton" Content="Refresh" Click="RefreshQuarantineButton_OnClick"/><Button Content="Open folder" Click="OpenQuarantineButton_OnClick"/><TextBlock Margin="12" VerticalAlignment="Center" Text="Cleanup is intentionally unavailable in this release."/></WrapPanel>
          <DataGrid x:Name="QuarantineGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" automation:AutomationProperties.Name="Retained rollback quarantine" />
        </Grid>
      </TabItem>

      <TabItem x:Name="LogsTab" Header="Logs"><TextBox x:Name="LogsBox" Margin="10" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
      <TabItem x:Name="SettingsTab" Header="Settings"><TextBlock Margin="18" TextWrapping="Wrap" Text="Csaver stores configuration, history, imports, and logs beside the executable. Mutating commands request administrator approval only when run."/></TabItem>
      <TabItem x:Name="AboutTab" Header="About"><TextBlock Margin="18" TextWrapping="Wrap" Text="Csaver is a native, portable Windows migration tool. It does not invoke PowerShell, cmd, or robocopy. Rollback payload cleanup is not available in this release."/></TabItem>
    </TabControl>
  </DockPanel>
</Window>
